# Aplicação
PORT=3000
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

# Banco de dados
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=protocolo_oficio

# RM Middleware (fonte oficial: RM/ACORP)
RM_MIDDLEWARE_MODE=mock
RM_MIDDLEWARE_BASE_URL=https://rm-middleware.exemplo.com.br/api
RM_MIDDLEWARE_API_KEY=
RM_MIDDLEWARE_WEBHOOK_SECRET=change-me
RM_SYNC_INTERVAL_MINUTES=10

# Fluig
FLUIG_MODE=mock
FLUIG_BASE_URL=https://fluig.exemplo.com.br/api
FLUIG_API_KEY=

# Upload de anexos
UPLOAD_DIR=./storage/anexos
