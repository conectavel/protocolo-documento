<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_eSenar" targetNamespace="http://esenar.senar.org.br/bpmn" exporter="Claude Code" exporterVersion="1.0">

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Parceiro" name="Parceiro / Sindicato Rural (Externo)" processRef="Process_Parceiro"/>
    <bpmn:participant id="Participant_eSenar" name="e-Senar — Sistema de Protocolo de Documentos" processRef="Process_eSenar"/>
    <bpmn:participant id="Participant_Fluig" name="Fluig — GED/BPM TOTVS (Externo)" processRef="Process_Fluig"/>
    <bpmn:participant id="Participant_Notif" name="Notificações (E-mail — simulado em dev)" processRef="Process_Notif"/>
    <bpmn:participant id="Participant_RM" name="RM Middleware — TOTVS RM / ACORP (Externo)" processRef="Process_RM"/>
    <bpmn:messageFlow id="Flow_Msg_Protocolar" name="protocolar (PDF + dados)" sourceRef="Throw_EnviarProtocolo" targetRef="Start_Protocolo"/>
    <bpmn:messageFlow id="Flow_Msg_Devolver" name="devolvido p/ ajuste" sourceRef="Throw_DevolverMsg" targetRef="Catch_Devolvido"/>
    <bpmn:messageFlow id="Flow_Msg_NotifParceiro" name="devolutiva final" sourceRef="Throw_NotifFinal" targetRef="Catch_ResultadoFinal"/>
    <bpmn:messageFlow id="Flow_Msg_NotifEmail" name="enviar e-mail (simulado)" sourceRef="Throw_NotifFinal" targetRef="Start_NotifTrigger"/>
    <bpmn:messageFlow id="Flow_Msg_Fluig" name="confirmar/cancelar evento" sourceRef="Task_ConfirmarEvento" targetRef="SubProcess_Execucao"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Parceiro" name="Parceiro" isExecutable="false">
    <bpmn:startEvent id="Start_Parceiro" name="Mobilizador/Presidente decide protocolar">
      <bpmn:outgoing>Flow_P1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_PreencherDados" name="Preencher dados do ofício e anexar PDF (ou gerar modelo automático)">
      <bpmn:incoming>Flow_P1</bpmn:incoming>
      <bpmn:outgoing>Flow_P2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="Throw_EnviarProtocolo" name="Enviar protocolo">
      <bpmn:incoming>Flow_P2</bpmn:incoming>
      <bpmn:incoming>Flow_P_Loop</bpmn:incoming>
      <bpmn:outgoing>Flow_P3</bpmn:outgoing>
      <bpmn:messageEventDefinition/>
    </bpmn:intermediateThrowEvent>
    <bpmn:eventBasedGateway id="Gateway_Aguardar" name="Aguarda retorno">
      <bpmn:incoming>Flow_P3</bpmn:incoming>
      <bpmn:outgoing>Flow_P4a</bpmn:outgoing>
      <bpmn:outgoing>Flow_P4b</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Catch_Devolvido" name="Devolvido para ajuste (RN-02)">
      <bpmn:incoming>Flow_P4a</bpmn:incoming>
      <bpmn:outgoing>Flow_P5</bpmn:outgoing>
      <bpmn:messageEventDefinition/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_Corrigir" name="Corrigir dados e reenviar (RN-11: reinicia prazo de 24h)">
      <bpmn:incoming>Flow_P5</bpmn:incoming>
      <bpmn:outgoing>Flow_P_Loop</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Catch_ResultadoFinal" name="Devolutiva final consolidada">
      <bpmn:incoming>Flow_P4b</bpmn:incoming>
      <bpmn:outgoing>Flow_P6</bpmn:outgoing>
      <bpmn:messageEventDefinition/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_Parceiro" name="Processo concluído">
      <bpmn:incoming>Flow_P6</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_P1" sourceRef="Start_Parceiro" targetRef="Task_PreencherDados"/>
    <bpmn:sequenceFlow id="Flow_P2" sourceRef="Task_PreencherDados" targetRef="Throw_EnviarProtocolo"/>
    <bpmn:sequenceFlow id="Flow_P3" sourceRef="Throw_EnviarProtocolo" targetRef="Gateway_Aguardar"/>
    <bpmn:sequenceFlow id="Flow_P4a" sourceRef="Gateway_Aguardar" targetRef="Catch_Devolvido"/>
    <bpmn:sequenceFlow id="Flow_P4b" sourceRef="Gateway_Aguardar" targetRef="Catch_ResultadoFinal"/>
    <bpmn:sequenceFlow id="Flow_P5" sourceRef="Catch_Devolvido" targetRef="Task_Corrigir"/>
    <bpmn:sequenceFlow id="Flow_P_Loop" sourceRef="Task_Corrigir" targetRef="Throw_EnviarProtocolo"/>
    <bpmn:sequenceFlow id="Flow_P6" sourceRef="Catch_ResultadoFinal" targetRef="End_Parceiro"/>
  </bpmn:process>

  <bpmn:process id="Process_eSenar" name="e-Senar" isExecutable="false">
    <bpmn:laneSet id="LaneSet_eSenar">
      <bpmn:lane id="Lane_Sistema" name="Sistema (Automático / Jobs)">
        <bpmn:flowNodeRef>Start_Protocolo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegistrarSolicitacao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CienciaAutomatica</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConsolidarStatusMacro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_NotifFinal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Resultado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Atendido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ParcialmenteAtendido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NaoAtendido</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CoordRegional" name="Coordenador Regional">
        <bpmn:flowNodeRef>Task_DarCiencia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Prazo24h</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Assessoria" name="Assessoria (Assessor)">
        <bpmn:flowNodeRef>Start_PreProtocolo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalisarSolicitacao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Decisao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Cancelado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_DevolverMsg</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Superintendencia" name="Superintendência">
        <bpmn:flowNodeRef>Task_Despachar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Execucao" name="Execução por Área (Diretor / Gestor / Coordenador)">
        <bpmn:flowNodeRef>SubProcess_Execucao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_TodosFinalizados</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Protocolo" name="Protocolo recebido">
      <bpmn:outgoing>Flow_E1</bpmn:outgoing>
      <bpmn:messageEventDefinition/>
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_PreProtocolo" name="Pré-Protocolo convertido pelo Assessor (subprocesso de e-mail)">
      <bpmn:outgoing>Flow_E1b</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_RegistrarSolicitacao" name="Registrar Solicitação (auto) — status inicial &quot;Em Análise Regional&quot;; nº processo; prazo 24h">
      <bpmn:incoming>Flow_E1</bpmn:incoming>
      <bpmn:incoming>Flow_E1b</bpmn:incoming>
      <bpmn:outgoing>Flow_E2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_DarCiencia" name="Dar Ciência do recebimento (RN-01, SLA 24h)">
      <bpmn:incoming>Flow_E2</bpmn:incoming>
      <bpmn:outgoing>Flow_E3a</bpmn:outgoing>
    </bpmn:task>
    <bpmn:boundaryEvent id="Boundary_Prazo24h" name="Prazo 24h" attachedToRef="Task_DarCiencia" cancelActivity="false">
      <bpmn:outgoing>Flow_E3b</bpmn:outgoing>
      <bpmn:timerEventDefinition/>
    </bpmn:boundaryEvent>
    <bpmn:task id="Task_CienciaAutomatica" name="Ciência automática (job a cada 15 min)">
      <bpmn:incoming>Flow_E3b</bpmn:incoming>
      <bpmn:outgoing>Flow_E4b</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AnalisarSolicitacao" name="Analisar Solicitação">
      <bpmn:incoming>Flow_E3a</bpmn:incoming>
      <bpmn:incoming>Flow_E4b</bpmn:incoming>
      <bpmn:outgoing>Flow_E5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Decisao" name="Decisão da Assessoria (RN-02)">
      <bpmn:incoming>Flow_E5</bpmn:incoming>
      <bpmn:outgoing>Flow_E6_Aprovar</bpmn:outgoing>
      <bpmn:outgoing>Flow_E6_Recusar</bpmn:outgoing>
      <bpmn:outgoing>Flow_E6_Devolver</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Cancelado" name="Cancelado">
      <bpmn:incoming>Flow_E6_Recusar</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="Throw_DevolverMsg" name="Notificar devolução">
      <bpmn:incoming>Flow_E6_Devolver</bpmn:incoming>
      <bpmn:messageEventDefinition/>
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="Task_Despachar" name="Despachar — selecionar Diretor(es) responsáveis (RN-05)">
      <bpmn:incoming>Flow_E6_Aprovar</bpmn:incoming>
      <bpmn:outgoing>Flow_E7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:subProcess id="SubProcess_Execucao" name="Execução por Item (multi-instância — ver Subprocesso 5.2)">
      <bpmn:incoming>Flow_E7</bpmn:incoming>
      <bpmn:incoming>Flow_E8_Nao</bpmn:incoming>
      <bpmn:outgoing>Flow_E8</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="false"/>
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="Gateway_TodosFinalizados" name="Todos os itens finalizados?">
      <bpmn:incoming>Flow_E8</bpmn:incoming>
      <bpmn:outgoing>Flow_E8_Nao</bpmn:outgoing>
      <bpmn:outgoing>Flow_E8_Sim</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ConsolidarStatusMacro" name="Consolidar Status Macro (automático) — RN-10">
      <bpmn:incoming>Flow_E8_Sim</bpmn:incoming>
      <bpmn:outgoing>Flow_E9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="Throw_NotifFinal" name="Notificar Devolutiva Final">
      <bpmn:incoming>Flow_E9</bpmn:incoming>
      <bpmn:outgoing>Flow_E10</bpmn:outgoing>
      <bpmn:messageEventDefinition/>
    </bpmn:intermediateThrowEvent>
    <bpmn:exclusiveGateway id="Gateway_Resultado" name="Resultado consolidado?">
      <bpmn:incoming>Flow_E10</bpmn:incoming>
      <bpmn:outgoing>Flow_E11_Atendido</bpmn:outgoing>
      <bpmn:outgoing>Flow_E11_Parcial</bpmn:outgoing>
      <bpmn:outgoing>Flow_E11_NaoAtendido</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Atendido" name="Atendido">
      <bpmn:incoming>Flow_E11_Atendido</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_ParcialmenteAtendido" name="Parcialmente Atendido">
      <bpmn:incoming>Flow_E11_Parcial</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_NaoAtendido" name="Não Atendido">
      <bpmn:incoming>Flow_E11_NaoAtendido</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_E1" sourceRef="Start_Protocolo" targetRef="Task_RegistrarSolicitacao"/>
    <bpmn:sequenceFlow id="Flow_E1b" sourceRef="Start_PreProtocolo" targetRef="Task_RegistrarSolicitacao"/>
    <bpmn:sequenceFlow id="Flow_E2" sourceRef="Task_RegistrarSolicitacao" targetRef="Task_DarCiencia"/>
    <bpmn:sequenceFlow id="Flow_E3a" name="ciência manual" sourceRef="Task_DarCiencia" targetRef="Task_AnalisarSolicitacao"/>
    <bpmn:sequenceFlow id="Flow_E3b" name="prazo vencido" sourceRef="Boundary_Prazo24h" targetRef="Task_CienciaAutomatica"/>
    <bpmn:sequenceFlow id="Flow_E4b" sourceRef="Task_CienciaAutomatica" targetRef="Task_AnalisarSolicitacao"/>
    <bpmn:sequenceFlow id="Flow_E5" sourceRef="Task_AnalisarSolicitacao" targetRef="Gateway_Decisao"/>
    <bpmn:sequenceFlow id="Flow_E6_Aprovar" name="Aprovar" sourceRef="Gateway_Decisao" targetRef="Task_Despachar"/>
    <bpmn:sequenceFlow id="Flow_E6_Recusar" name="Recusar (motivo obrigatório)" sourceRef="Gateway_Decisao" targetRef="End_Cancelado"/>
    <bpmn:sequenceFlow id="Flow_E6_Devolver" name="Devolver p/ ajuste (motivo obrigatório)" sourceRef="Gateway_Decisao" targetRef="Throw_DevolverMsg"/>
    <bpmn:sequenceFlow id="Flow_E7" sourceRef="Task_Despachar" targetRef="SubProcess_Execucao"/>
    <bpmn:sequenceFlow id="Flow_E8" sourceRef="SubProcess_Execucao" targetRef="Gateway_TodosFinalizados"/>
    <bpmn:sequenceFlow id="Flow_E8_Nao" name="Não" sourceRef="Gateway_TodosFinalizados" targetRef="SubProcess_Execucao"/>
    <bpmn:sequenceFlow id="Flow_E8_Sim" name="Sim" sourceRef="Gateway_TodosFinalizados" targetRef="Task_ConsolidarStatusMacro"/>
    <bpmn:sequenceFlow id="Flow_E9" sourceRef="Task_ConsolidarStatusMacro" targetRef="Throw_NotifFinal"/>
    <bpmn:sequenceFlow id="Flow_E10" sourceRef="Throw_NotifFinal" targetRef="Gateway_Resultado"/>
    <bpmn:sequenceFlow id="Flow_E11_Atendido" name="todos Atendido" sourceRef="Gateway_Resultado" targetRef="End_Atendido"/>
    <bpmn:sequenceFlow id="Flow_E11_Parcial" name="misto" sourceRef="Gateway_Resultado" targetRef="End_ParcialmenteAtendido"/>
    <bpmn:sequenceFlow id="Flow_E11_NaoAtendido" name="todos Não Atendido" sourceRef="Gateway_Resultado" targetRef="End_NaoAtendido"/>
  </bpmn:process>

  <bpmn:process id="Process_Fluig" name="Fluig" isExecutable="false">
    <bpmn:startEvent id="Start_Fluig" name="Evento agendado no Fluig (pós-devolutiva)">
      <bpmn:outgoing>Flow_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_ConfirmarEvento" name="Confirmar / cancelar evento agendado (webhook assíncrono — RN-12)">
      <bpmn:incoming>Flow_F1</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_F1" sourceRef="Start_Fluig" targetRef="Task_ConfirmarEvento"/>
  </bpmn:process>

  <bpmn:process id="Process_Notif" name="Notificações" isExecutable="false">
    <bpmn:startEvent id="Start_NotifTrigger" name="Notificação recebida">
      <bpmn:outgoing>Flow_N1</bpmn:outgoing>
      <bpmn:messageEventDefinition/>
    </bpmn:startEvent>
    <bpmn:task id="Task_RegistrarNotificacao" name="Registrar e enviar e-mail (simulado — apenas log)">
      <bpmn:incoming>Flow_N1</bpmn:incoming>
      <bpmn:outgoing>Flow_N2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Notif" name="E-mail enviado (simulado)">
      <bpmn:incoming>Flow_N2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_N1" sourceRef="Start_NotifTrigger" targetRef="Task_RegistrarNotificacao"/>
    <bpmn:sequenceFlow id="Flow_N2" sourceRef="Task_RegistrarNotificacao" targetRef="End_Notif"/>
  </bpmn:process>

  <bpmn:process id="Process_RM" name="RM Middleware" isExecutable="false">
    <bpmn:startEvent id="Start_RM" name="A cada 10 min ou webhook em tempo real">
      <bpmn:outgoing>Flow_R1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_SincronizarCadastros" name="Sincronizar Parceiro / Mobilizador / Presidente / Coordenador Regional (upsert + log)">
      <bpmn:incoming>Flow_R1</bpmn:incoming>
      <bpmn:outgoing>Flow_R2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_RM" name="Cadastros atualizados">
      <bpmn:incoming>Flow_R2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_R1" sourceRef="Start_RM" targetRef="Task_SincronizarCadastros"/>
    <bpmn:sequenceFlow id="Flow_R2" sourceRef="Task_SincronizarCadastros" targetRef="End_RM"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collaboration_1">

      <bpmndi:BPMNShape id="Shape_Participant_Parceiro" bpmnElement="Participant_Parceiro" isHorizontal="true">
        <dc:Bounds x="10" y="20" width="3070" height="200"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Participant_eSenar" bpmnElement="Participant_eSenar" isHorizontal="true">
        <dc:Bounds x="10" y="240" width="3070" height="850"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Sistema" bpmnElement="Lane_Sistema" isHorizontal="true">
        <dc:Bounds x="40" y="240" width="3040" height="170"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_CoordRegional" bpmnElement="Lane_CoordRegional" isHorizontal="true">
        <dc:Bounds x="40" y="410" width="3040" height="170"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Assessoria" bpmnElement="Lane_Assessoria" isHorizontal="true">
        <dc:Bounds x="40" y="580" width="3040" height="170"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Superintendencia" bpmnElement="Lane_Superintendencia" isHorizontal="true">
        <dc:Bounds x="40" y="750" width="3040" height="170"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Execucao" bpmnElement="Lane_Execucao" isHorizontal="true">
        <dc:Bounds x="40" y="920" width="3040" height="170"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Participant_Fluig" bpmnElement="Participant_Fluig" isHorizontal="true">
        <dc:Bounds x="10" y="1110" width="3070" height="170"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Participant_Notif" bpmnElement="Participant_Notif" isHorizontal="true">
        <dc:Bounds x="10" y="1300" width="3070" height="170"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Participant_RM" bpmnElement="Participant_RM" isHorizontal="true">
        <dc:Bounds x="10" y="1490" width="3070" height="170"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Start_Parceiro" bpmnElement="Start_Parceiro">
        <dc:Bounds x="132" y="92" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_PreencherDados" bpmnElement="Task_PreencherDados">
        <dc:Bounds x="290" y="70" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Throw_EnviarProtocolo" bpmnElement="Throw_EnviarProtocolo">
        <dc:Bounds x="512" y="92" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Aguardar" bpmnElement="Gateway_Aguardar">
        <dc:Bounds x="625" y="85" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Catch_Devolvido" bpmnElement="Catch_Devolvido">
        <dc:Bounds x="732" y="47" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Corrigir" bpmnElement="Task_Corrigir">
        <dc:Bounds x="900" y="25" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Catch_ResultadoFinal" bpmnElement="Catch_ResultadoFinal">
        <dc:Bounds x="832" y="147" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Parceiro" bpmnElement="End_Parceiro">
        <dc:Bounds x="1032" y="147" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Start_Protocolo" bpmnElement="Start_Protocolo">
        <dc:Bounds x="512" y="307" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_PreProtocolo" bpmnElement="Start_PreProtocolo">
        <dc:Bounds x="132" y="647" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_RegistrarSolicitacao" bpmnElement="Task_RegistrarSolicitacao">
        <dc:Bounds x="670" y="285" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_DarCiencia" bpmnElement="Task_DarCiencia">
        <dc:Bounds x="1040" y="455" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Boundary_Prazo24h" bpmnElement="Boundary_Prazo24h">
        <dc:Bounds x="1107" y="517" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_CienciaAutomatica" bpmnElement="Task_CienciaAutomatica">
        <dc:Bounds x="1240" y="285" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_AnalisarSolicitacao" bpmnElement="Task_AnalisarSolicitacao">
        <dc:Bounds x="1430" y="625" width="100" height="80"/>
